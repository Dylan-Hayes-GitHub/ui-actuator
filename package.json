{
  "name": "ui-actuator",
  "version": "0.1.0",
  "description": "Actuator-style version info for frontend apps",
  "type": "module",
  "bin": {
    "ui-actuator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.3"
  }
}
